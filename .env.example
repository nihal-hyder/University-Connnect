# -----------------------------------------------------------------------------
# CampusConnect Pakistan — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser; everything else is
# server-only.
# -----------------------------------------------------------------------------

# Public base URL of the app (no trailing slash). Used in emails, redirects,
# QR tickets and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard -> Project Settings -> API Keys).
# For local development, `npx supabase status` prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# SERVER ONLY. Used by the scheduled job route and admin bootstrap script.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Email delivery via Resend (https://resend.com). Leave RESEND_API_KEY empty to
# run in development mode: emails are recorded as "logged_dev" and NOT sent.
RESEND_API_KEY=
EMAIL_FROM="CampusConnect <notifications@your-verified-domain.pk>"
EMAIL_REPLY_TO=
# Optional. Signing secret (whsec_...) of a Resend webhook pointing at
# https://<your-domain>/api/webhooks/resend with the email.delivered,
# email.bounced and email.complained events. Enables delivered/bounced status.
RESEND_WEBHOOK_SECRET=

# Shared secret for /api/jobs/process (scheduled reminders + email queue).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_SECRET=replace_with_a_long_random_string
# On Vercel, also set CRON_SECRET to the SAME value: Vercel Cron sends it as the
# bearer token. (Not needed locally.)

# Salt for anonymous page-view hashing. Any long random string.
VIEW_HASH_SALT=replace_with_a_long_random_string
